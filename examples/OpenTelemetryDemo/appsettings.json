{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Extensions.Hosting": "Warning"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "ImageRating",
        "enabled": true,
        "telemetry": {
          "enabled": true,
          "metadata": {
            "Label": "A Label",
            "Etag": "An etag"
          }
        },
        "variants": [
          {
            "name": "BlackAndWhite",
            "configuration_value": "https://cdn.pixabay.com/photo/2017/09/28/09/26/dinosaur-2794840_1280.png"
          },
          {
            "name": "WithColor",
            "configuration_value": "https://cdn.pixabay.com/photo/2012/04/02/15/18/stegosaurus-24752_1280.png"
          }
        ],
        "allocation": {
          "percentile": [
            {
              "variant": "BlackAndWhite",
              "from": 0,
              "to": 50
            },
            {
              "variant": "WithColor",
              "from": 50,
              "to": 100
            }
          ],
          "default_when_enabled": "BlackAndWhite"
        }
      }
    ]
  }
}
